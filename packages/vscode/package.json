{
  "name": "laika",
  "displayName": "Laika",
  "description": "BYOK coding agent with a usage-anchored context engine and Orbit, a 50,000-ft view of the live codebase morph.",
  "version": "0.0.1",
  "publisher": "laika",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onView:laika.sidebar",
    "onCommand:laika.open",
    "onCommand:laika.orbit.toggle",
    "onCommand:laika.keys.set",
    "onCommand:laika.keys.clear"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "laika.open",
        "title": "Open",
        "category": "Laika"
      },
      {
        "command": "laika.orbit.toggle",
        "title": "Toggle Orbit",
        "category": "Laika"
      },
      {
        "command": "laika.keys.set",
        "title": "Set API Key",
        "category": "Laika"
      },
      {
        "command": "laika.keys.clear",
        "title": "Clear API Key",
        "category": "Laika"
      }
    ],
    "configuration": {
      "title": "Laika",
      "properties": {
        "laika.provider": {
          "type": "string",
          "enum": ["anthropic", "openai"],
          "default": "anthropic",
          "description": "Active provider for the current SecretStorage profile."
        },
        "laika.model": {
          "type": "string",
          "default": "claude-sonnet-4-5",
          "description": "Model id from models/models.json."
        },
        "laika.profile": {
          "type": "string",
          "default": "default",
          "description": "Named SecretStorage profile (for example work or personal)."
        },
        "laika.modelOverrides": {
          "type": "object",
          "default": {},
          "description": "Per-model capability overrides. User values always win over the shipped registry (never a truthy 128k default)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "laika",
          "title": "Laika",
          "icon": "media/laika.svg"
        }
      ]
    },
    "views": {
      "laika": [
        {
          "type": "webview",
          "id": "laika.sidebar",
          "name": "Laika"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "dev": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"process.exit(0)\"",
    "lint": "node -e \"process.exit(0)\"",
    "package": "pnpm build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@laika/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
